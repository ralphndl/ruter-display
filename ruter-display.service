[Unit]
Description=Oslo Departures (independent departure board)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Template: make service fills in the current user, checkout and Node.js path.
User=pi
WorkingDirectory=/home/pi/ruter-display
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
# Application settings are read from config.json in the checkout.

[Install]
WantedBy=multi-user.target
